---
import Base from "@/layouts/Base.astro"
import StateSummary, { type Stat } from "@/components/StateSummary"
import { THEMES } from "@/lib/pages"
import { series } from "@/lib/data"

function latest(id: string, real = false) {
  const s = series(id)
  const i = s.dates.length - 1
  const vals = real && s.real ? s.real : s.values
  return { date: s.dates[i], values: Object.fromEntries(Object.entries(vals).filter(([, v]) => v[i] != null).map(([g, v]) => [g, v[i] as number])) }
}
const stats: Stat[] = [
  { label: "Desemprego", fmt: "pct", higherIsBetter: false, href: "trabalho/", ...latest("desemprego_uf") },
  { label: "PIB per capita", fmt: "brl", higherIsBetter: true, href: "economia/", ...latest("pib_per_capita_uf", true) },
  { label: "Homicídios por 100 mil", fmt: "num1", higherIsBetter: false, href: "sociedade/", ...latest("homicidios_uf") },
  { label: "Mortalidade infantil por mil", fmt: "num1", higherIsBetter: false, href: "sociedade/", ...latest("mortalidade_infantil_uf") },
]
---
<Base title="Início" description="Dados públicos do Brasil desde 2002 em gráficos, com a fonte de cada número: economia, trabalho, contas públicas, corrupção, sociedade e COVID." current="home">
  <section class="flex max-w-2xl flex-col gap-2">
    <h1 class="text-3xl font-semibold tracking-tight">O Brasil desde 2002, em dados oficiais</h1>
    <p class="text-muted-foreground">
      Escolha seu estado no topo da página e ele aparece destacado em todos os gráficos.
      Cada número traz a fonte, e todos os dados podem ser baixados em CSV.
    </p>
  </section>
  <StateSummary client:load stats={stats} />
  <section aria-labelledby="temas" class="flex flex-col gap-3">
    <h2 id="temas" class="text-sm font-medium text-muted-foreground">Temas</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {THEMES.map((t) => (
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${t.slug}/`} class="flex flex-col gap-1 rounded-lg border bg-card p-4 hover:border-ring">
          <span class="font-medium">{t.title}</span>
          <span class="text-sm text-muted-foreground">{t.intro}</span>
          <span class="text-xs text-muted-foreground">{t.charts.length} gráficos</span>
        </a>
      ))}
    </div>
  </section>
</Base>
