---
import Base from "@/layouts/Base.astro"
import StateSummary, { type Stat } from "@/components/StateSummary"
import { THEMES } from "@/lib/pages"
import { series, catalog } from "@/lib/data"
import { dateLabel, fmt } from "@/lib/format"
import { sparkPath } from "@/lib/spark"

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "")
function stat(id: string, real = false) {
  const s = series(id)
  const i = s.dates.length - 1
  const vals = real && s.real ? s.real : s.values
  return {
    date: s.dates[i], since: s.dates[0], history: vals,
    values: Object.fromEntries(Object.entries(vals).filter(([, v]) => v[i] != null).map(([g, v]) => [g, v[i] as number])),
  }
}
const stats: Stat[] = [
  { label: "Desemprego", fmt: "pct", higherIsBetter: false, href: "trabalho/#desemprego_uf-time", ...stat("desemprego_uf") },
  { label: "PIB per capita", fmt: "brl", higherIsBetter: true, href: "economia/#pib_per_capita_uf-time", ...stat("pib_per_capita_uf", true) },
  { label: "Homicídios por 100 mil", fmt: "num1", higherIsBetter: false, href: "sociedade/#homicidios_uf-time", ...stat("homicidios_uf") },
  { label: "Mortalidade infantil por mil", fmt: "num1", higherIsBetter: false, href: "sociedade/#mortalidade_infantil_uf-time", ...stat("mortalidade_infantil_uf") },
]
// Each theme card shows its lead national series: the trend and the latest value.
const cards = THEMES.map((t) => {
  const lead = t.charts.find((c) => c.kind === "time") ?? t.charts[0]
  const s = series(lead.id)
  const src = s.real ?? s.values
  // no national line (e.g. FPE): show the sum of the states, which is the national total
  const total = !src.BR && !src.BRA
  const vals = total
    ? s.dates.map((_, i) => Object.values(src).reduce((a, v) => a + (v[i] ?? 0), 0))
    : src.BR ?? src.BRA
  const i = vals.length - 1
  const what = total ? `${s.meta.title}, total dos estados` : lead.title ?? s.meta.title
  return { ...t, path: sparkPath(vals, 160, 40), value: fmt(vals[i], lead.fmt), what, when: dateLabel(s.dates[i]) }
})
---
<Base title="Início" description="Dados públicos do Brasil desde 2002 em gráficos, com a fonte de cada número: economia, trabalho, contas públicas, corrupção, sociedade e COVID." current="home">
  <section class="flex flex-col gap-4 pt-4 sm:pt-8">
    <p class="num text-xs uppercase tracking-[0.18em] text-muted-foreground">2002 – hoje · {Object.keys(catalog.series).length} séries · 27 estados</p>
    <h1 class="max-w-3xl text-5xl font-bold leading-[1.02] sm:text-6xl">O Brasil desde 2002, em dados oficiais.</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      Economia, trabalho, contas públicas, corrupção, sociedade e COVID, cada número com a sua fonte.
      Escolha seu estado no topo e ele aparece destacado em todos os gráficos.
    </p>
  </section>

  <StateSummary client:load stats={stats} />

  <section aria-labelledby="temas" class="flex flex-col gap-4">
    <h2 id="temas" class="text-2xl font-semibold">Temas</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((t) => (
        <a href={`${BASE}/${t.slug}/`} class="group flex flex-col gap-3 rounded-xl border bg-card p-5 transition-colors hover:border-ring">
          <div class="flex items-baseline justify-between gap-2">
            <span class="font-display text-xl font-semibold">{t.title}</span>
            <span class="text-muted-foreground transition-transform group-hover:translate-x-0.5" aria-hidden>→</span>
          </div>
          <svg viewBox="0 0 160 40" class="h-10 w-full" preserveAspectRatio="none" aria-hidden>
            <path d={t.path} fill="none" stroke="var(--chart-1)" stroke-width="2" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="flex flex-col">
            <span class="font-display text-2xl font-semibold leading-tight">{t.value}</span>
            <span class="text-xs text-muted-foreground">{t.what}, {t.when}</span>
          </div>
          <p class="text-sm text-muted-foreground">{t.intro}</p>
        </a>
      ))}
      <a href={`${BASE}/sobre/`} class="flex flex-col justify-between gap-3 rounded-xl border border-dashed p-5 text-sm text-muted-foreground hover:border-ring hover:text-foreground">
        <span class="font-display text-xl font-semibold text-foreground">Sobre os dados</span>
        <span>De onde vem cada número, o que ficou de fora e como baixar tudo em CSV.</span>
      </a>
    </div>
  </section>
</Base>
